<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml: tells Android what the app contains and what it needs.

  Media import needs NO storage permissions:
  - Videos/photos come from the Android Photo Picker.
  - Audio comes from the system file picker.
  Both grant access to only the files you pick.

  Network is used for ONE thing only: the in-app updater, which checks this
  app's GitHub Releases page. Editing and AI features stay fully offline.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Updater: talk to GitHub, and ask Android to install the downloaded update. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Export + Auto Highlights run as foreground services (with a progress notification),
         so they keep going when you leave the app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only Android 8–9 need this to save into the gallery. Newer versions don't. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".JustVideoApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.JustVideo">

        <!-- The one and only screen container. Compose draws everything inside it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Renders exports in the background (hardware encoder, progress notification). -->
        <service
            android:name=".media.export.ExportService"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing|dataSync" />

        <!-- Receives the result of installing an update (success, needs confirmation, or failed).
             Not exported: only Android's installer, through our own PendingIntent, can reach it. -->
        <receiver
            android:name=".core.update.InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
